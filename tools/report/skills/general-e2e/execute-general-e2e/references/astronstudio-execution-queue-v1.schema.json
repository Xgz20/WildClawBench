{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:astronstudio-execution-queue:v1",
  "title": "AstronStudio General E2E concurrent execution queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "worker",
    "identity",
    "dataset",
    "configuration",
    "phase",
    "current_task_id",
    "runtime",
    "tasks",
    "history",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "wildclawbench.general-e2e-astronstudio-execution-queue/v1"
    },
    "revision": {"const": 1},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"enum": ["astronstudio-macos-serial", "astronstudio-macos-concurrent"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "unit_id", "queue_id", "queue_digest"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "queue_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "queue_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "unit_id",
        "dataset_id",
        "dataset_digest",
        "manifest_sha256",
        "run_config_digest",
        "task_ids",
        "ui_slots",
        "run_slots",
        "continue_on_terminal_failure",
        "driver_options"
      ],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_digest": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "run_config_digest": {"$ref": "#/$defs/sha256"},
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ui_slots": {"const": 1},
        "run_slots": {"type": "integer", "minimum": 1, "maximum": 8, "default": 3},
        "continue_on_terminal_failure": {"type": "boolean"},
        "driver_options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_ms", "poll_interval_ms", "identity_timeout_ms"],
          "properties": {
            "timeout_ms": {"type": "integer", "minimum": 1},
            "poll_interval_ms": {"type": "integer", "minimum": 1},
            "identity_timeout_ms": {"type": "integer", "minimum": 120000, "maximum": 180000}
          }
        }
      }
    },
    "phase": {
      "enum": ["PREPARED", "RUNNING", "NEEDS_ATTENTION", "COMPLETED", "COMPLETED_WITH_FAILURES", "FAILED"]
    },
    "current_task_id": {"type": ["string", "null"]},
    "active_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_pid",
        "worker_started_at",
        "heartbeat_at",
        "interrupted_at",
        "recovered_stale_lock"
      ],
      "properties": {
        "worker_pid": {"type": ["integer", "null"], "minimum": 1},
        "worker_started_at": {"$ref": "#/$defs/nullableString"},
        "heartbeat_at": {"type": "string", "format": "date-time"},
        "interrupted_at": {"$ref": "#/$defs/nullableString"},
        "recovered_stale_lock": {"type": "boolean"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "event"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "event": {"type": "string", "minLength": 1}
        }
      }
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableString": {"type": ["string", "null"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "task_id",
        "phase",
        "selected_attempt_id",
        "attempts",
        "execution_state_path",
        "execution_record_path",
        "started_at",
        "finished_at",
        "driver_exit_code",
        "dispatch_attempt_count",
        "session",
        "error"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "task_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["PENDING", "RUNNING", "NEEDS_ATTENTION", "COMPLETED", "FAILED"]},
        "selected_attempt_id": {"$ref": "#/$defs/nullableString"},
        "attempts": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt_id", "state_path", "registered_at", "selected"],
            "properties": {
              "attempt_id": {"type": "string", "minLength": 1},
              "state_path": {"type": "string", "minLength": 1},
              "registered_at": {"type": "string", "format": "date-time"},
              "selected": {"const": true}
            }
          }
        },
        "execution_state_path": {"type": "string", "minLength": 1},
        "execution_record_path": {"type": "string", "minLength": 1},
        "started_at": {"$ref": "#/$defs/nullableString"},
        "finished_at": {"$ref": "#/$defs/nullableString"},
        "driver_exit_code": {"type": ["integer", "null"]},
        "dispatch_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_id", "turn_id", "session_id", "cwd"],
          "properties": {
            "thread_id": {"$ref": "#/$defs/nullableString"},
            "turn_id": {"$ref": "#/$defs/nullableString"},
            "session_id": {"$ref": "#/$defs/nullableString"},
            "cwd": {"$ref": "#/$defs/nullableString"}
          }
        },
        "error": {"type": ["object", "null"]}
      }
    }
  }
}
