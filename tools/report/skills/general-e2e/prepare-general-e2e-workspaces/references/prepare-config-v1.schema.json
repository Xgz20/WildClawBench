{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:prepare-config:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "bundle_protocol",
    "batch_id",
    "task_ids",
    "units",
    "judge",
    "report"
  ],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:prepare-config:v1"},
    "schema_version": {"const": 1},
    "contract_version": {"const": "general-e2e-contract-v1"},
    "bundle_protocol": {"const": "general-e2e-package-v1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "judge": {"$ref": "#/$defs/judge"},
    "report": {"$ref": "#/$defs/report"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "nullableString": {"type": ["string", "null"]},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "platform": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/nullableString"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_id", "reasoning_effort"],
      "properties": {
        "requested_id": {"type": "string", "minLength": 1},
        "reasoning_effort": {"$ref": "#/$defs/nullableString"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "task_ids", "harness", "model", "execution_mode"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/id"},
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "harness": {"$ref": "#/$defs/harness"},
        "model": {"$ref": "#/$defs/model"},
        "execution_mode": {"enum": ["automatic", "human_assisted"]}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "model", "reasoning_effort"],
      "properties": {
        "protocol": {"enum": ["codex-agent-judge-v1", "api-judge-v1"]},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"$ref": "#/$defs/nullableString"}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1}
      }
    }
  }
}
