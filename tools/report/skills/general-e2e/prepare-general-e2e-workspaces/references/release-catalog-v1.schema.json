{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:release-catalog:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "bundle_protocol",
    "scene",
    "release_id",
    "source_revision",
    "catalog_digest_algorithm",
    "catalog_digest",
    "schemas",
    "skill_count",
    "skills"
  ],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:release-catalog:v1"},
    "schema_version": {"const": 1},
    "contract_version": {"const": "general-e2e-contract-v1"},
    "bundle_protocol": {"const": "general-e2e-package-v1"},
    "scene": {"const": "general-e2e"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source_revision": {"$ref": "#/$defs/revision"},
    "catalog_digest_algorithm": {"const": "wildclawbench.release-catalog-sha256/v1"},
    "catalog_digest": {"$ref": "#/$defs/sha256"},
    "schemas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "skill_count": {"const": 7},
    "skills": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256", "size"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_revision",
        "source_root",
        "vendor_root",
        "entrypoints",
        "content_hash_algorithm",
        "content_sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_revision": {"$ref": "#/$defs/revision"},
        "source_root": {"$ref": "#/$defs/relativePath"},
        "vendor_root": {"$ref": "#/$defs/relativePath"},
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "content_hash_algorithm": {"const": "wildclawbench.component-content-sha256/v1"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scene",
        "version",
        "contract_version",
        "bundle_protocol",
        "implementation_status",
        "stages",
        "source_revision",
        "archive",
        "file_count",
        "content_hash_algorithm",
        "content_sha256",
        "zip_hash_algorithm",
        "zip_sha256",
        "components",
        "development_repository_references"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "scene": {"const": "general-e2e"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contract_version": {"const": "general-e2e-contract-v1"},
        "bundle_protocol": {"const": "general-e2e-package-v1"},
        "implementation_status": {"enum": ["interface_only", "operational"]},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_revision": {"$ref": "#/$defs/revision"},
        "archive": {"$ref": "#/$defs/relativePath"},
        "file_count": {"type": "integer", "minimum": 1},
        "content_hash_algorithm": {"const": "wildclawbench.skill-content-sha256/v1"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "zip_hash_algorithm": {"const": "sha256"},
        "zip_sha256": {"$ref": "#/$defs/sha256"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "development_repository_references": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
