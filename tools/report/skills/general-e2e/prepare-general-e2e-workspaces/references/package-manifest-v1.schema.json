{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:package-manifest:v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "manifest_kind",
    "contract_version",
    "bundle_protocol",
    "batch_id",
    "dataset",
    "release",
    "task_ids",
    "required_skills"
  ],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:package-manifest:v1"},
    "schema_version": {"const": 1},
    "manifest_kind": {"enum": ["batch", "execution", "scoring"]},
    "contract_version": {"const": "general-e2e-contract-v1"},
    "bundle_protocol": {"const": "general-e2e-package-v1"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "release": {"$ref": "#/$defs/release"},
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {"type": "array", "items": {"type": "object"}},
    "units": {"type": "array", "items": {"type": "object"}},
    "unit": {"type": "object"},
    "required_skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requiredSkill"}
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_kind": {"const": "batch"}}},
      "then": {"required": ["units", "artifacts"]},
      "else": {"required": ["unit_id", "unit", "tasks"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "bundle_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog_digest", "catalog_sha256", "suite_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "catalog_digest": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "suite_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requiredSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_status", "content_sha256", "zip_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_status": {"enum": ["interface_only", "operational"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "zip_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "role", "path", "sha256", "size"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["execution", "scoring"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
