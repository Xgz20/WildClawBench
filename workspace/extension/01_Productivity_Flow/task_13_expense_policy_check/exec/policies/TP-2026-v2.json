  "rule": "Reject the full expense when a receipt is required but missing, or when the amount exceeds the per-expense limit.",
  "categories": {
    "taxi": {"limit": 100.0, "receipt_required": true},
    "meal": {"limit": 100.0, "receipt_required": true},
    "hotel": {"limit": 600.0, "receipt_required": true},
    "office": {"limit": 300.0, "receipt_required": true}
  }
}
