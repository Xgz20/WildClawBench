{
  "schema_version": "h006-source-annotations/v1",
  "manuals": [
    {
      "file": "01_customer.docx",
      "title": "客户支持受理手册",
      "version": "2026-05-12",
      "clauses": [
        [
          "CS01",
          "入口与身份",
          "统一入口为售后工单台。REG仅登记本次联系并核对订单身份，不代表新建第二个退款案。保存订单号、回访渠道和实际联系时间。"
        ],
        [
          "CS02",
          "首次响应",
          "首次响应为4工作小时，从本次联系登记起算。补证、审批、检验或风险暂停均不能暂停此首次响应时钟。不得把内部处理时限作为首次响应承诺。"
        ],
        [
          "CS03",
          "资料核验",
          "DOC核验订单、申请说明、金额、购买凭证和授权记录。资料不齐时REQUEST_DOCS由CS补证；缺证据不等于最终拒绝退款。不能为了快捷而代填不存在的资料。"
        ],
        [
          "CS04",
          "办理边界",
          "操作员仅核对与交接，不能自行审批、换收款账户或划款。没有财务回执不得使用CLAIM_PAID表示已退款；不要把已转财务写成已付款。"
        ],
        [
          "CS99",
          "历史首次响应口径",
          "早期坐席附录曾写首次响应为2工作日。是否仍适用必须按authority.yaml的控制项裁决，不能把它与CS02并列为可任选口径。"
        ]
      ]
    },
    {
      "file": "02_warehouse.docx",
      "title": "仓储接收与保管规程",
      "version": "2026-04-16",
      "clauses": [
        [
          "WH01",
          "包裹接收",
          "RECV指包裹签收登记与保管，入口为仓储收货队列，责任岗位WH。未收到实物时WAIT_RECEIPT，不虚构签收单。"
        ],
        [
          "WH02",
          "物流时限",
          "签收入仓核对为24自然小时，限定物流接收事项，不能推成实物验收已通过，也不是财务付款时限。"
        ],
        [
          "WH03",
          "交接给质检",
          "签收和实物验收是不同节点。INSPECT由QA完成；仅有签收不得满足财务实物验收门禁。安全风险存在时不得处置、销毁或自行放行。"
        ],
        [
          "WH99",
          "历史验收附录",
          "旧仓储附录将实物验收写为24小时。最终质检时效由其职权域的有效条款决定，不按签收任务的名称或时限直接套用。"
        ]
      ]
    },
    {
      "file": "03_quality.docx",
      "title": "质检验收与安全异常规程",
      "version": "2026-06-08",
      "clauses": [
        [
          "QA01",
          "实物验收",
          "实物验收为2工作日，由QA负责，入口为质检验收队列。仓储签收不能代替验收，附录24小时不能覆盖本事项时限。"
        ],
        [
          "QA02",
          "安全冻结",
          "发现安全风险先SAFE_HOLD，暂停资金和实物处置，再SAFE_REPORT报QA。安全解除确认必须来自QA，财务批准或OPS协调均不代替安全解除。"
        ],
        [
          "QA03",
          "报告与暂停",
          "安全报告为1工作小时的内部升级事项，不替代客户首次响应4工作小时。原财务时钟已经开始时暂停，未开始仍不开始；解除后接续剩余处理额度，不RESET_CLOCK重新起算。"
        ],
        [
          "QA04",
          "未决状态",
          "在当前材料只有风险标记、没有解除记录时，路径止于报告和风险交接，不假设已经检验通过或已解除。RELEASE_WITHOUT_CLEARANCE不允许。"
        ]
      ]
    },
    {
      "file": "04_finance.docx",
      "title": "退款审批与资金执行控制",
      "version": "2026-05-20",
      "clauses": [
        [
          "FI01",
          "审批金额门槛",
          "含税退款金额不足5000元由OPS审批；达到5000元（含）由FC审批。批准须书面且在实物验收之后形成，口头担保、角色不符或预审批均不能作为有效资金批准。"
        ],
        [
          "FI02",
          "审批与执行分离",
          "资金执行岗位为FE。VERIFY_APPR核对有效批准，VERIFY_BANK核对当前收款账户，之后才HANDOFF_FIN转财务执行。OPS_PAY不允许。任何风险未解除、资料不齐、实物未验收或批准无效时，都不能PAY_BEFORE_GATE。"
        ],
        [
          "FI03",
          "资金处理时钟",
          "资金处理额度为2工作日，从资料齐备、实物验收、有效书面批准三个门禁最后满足之时启动。账户异常、撤回请求、安全或隐私风险使已运行时钟暂停；首次响应不随之暂停。暂停解除后保留已有起算点与剩余额度，不能重置为新的2工作日。"
        ],
        [
          "FI04",
          "撤回核对",
          "收到撤回请求时先PAUSE_PAYMENT，再WITHDRAW_REVIEW交FC确认和审批撤回，即使工单显示尚未划款也不能由CS直接关单。CLOSE_WITHOUT_FIN和删除审计不允许；不假设账务已冲回。"
        ],
        [
          "FI05",
          "账户变更",
          "账户发生变更且当前账户未核验时，PAUSE_PAYMENT并BANK_REVIEW交FC。不得沿用旧账户验证，不得SWITCH_BANK_UNVERIFIED，也不能因紧急而先付。有效退款批准的金额权限不因账户核验流程变更。"
        ]
      ]
    },
    {
      "file": "05_operations.docx",
      "title": "运营协作与历史处理口径",
      "version": "2026-09-10",
      "clauses": [
        [
          "OP01",
          "历史时效",
          "运营早期说明将所有受理和内部流转默认写成3工作日。它不能不分事项地覆盖客户首次响应、实物验收和资金处理控制项。"
        ],
        [
          "OP02",
          "历史金额口径",
          "历史运营说明写不超过5000元可由OPS批准，恰好5000元的边界与财务控制不同。采用何者取决于授权矩阵，不按文档日期较新自动覆盖。"
        ],
        [
          "OP03",
          "紧急参考口径",
          "历史绿色通道曾建议紧急申请先付款后补单。紧急仅可升级内部协作，不改变审批、门禁、执行岗位及风险解除条件。"
        ],
        [
          "OP04",
          "联合异常协调",
          "安全与隐私并发时，由OPS作JOINT_COORD协调。先完成两类暂停，再分别报告；两域报告顺序可交换，QA与PR分别确认解除。OPS不能代替任一域签字放行。"
        ],
        [
          "OP05",
          "重复申请",
          "已有linked_case_id时，LINK关联原案，本次联系仍REG并响应。不得NEW_CASE新建独立退款流程，不得另起付款、重复补证或RESET_CLOCK；沿用原案时钟状态而非宣称已重启。"
        ]
      ]
    },
    {
      "file": "06_compliance.docx",
      "title": "合规隐私与审计治理说明",
      "version": "2026-10-25",
      "clauses": [
        [
          "CO01",
          "隐私异常",
          "发现隐私风险先PRIV_HOLD停止对外扩散，再PRIV_ISOLATE登记隔离请求并PRIV_REPORT报PR。内部报告额度为1工作小时。隐私解除由PR确认，不能由CS删数据或OPS、FC代替解除。"
        ],
        [
          "CO02",
          "权限域",
          "本文件的强制权限域是隐私和审计，不拥有退款资金SLA、金额审批或质检验收控制项。不能因为本文件日期最新，就用其跨域建议覆盖财务或质检规则。"
        ],
        [
          "CO03",
          "审计保留",
          "所有路线保留原案、资料、批准及异常轨迹，DELETE_AUDIT不允许。缺回执不得声称已付款，缺解除不得声称已恢复，规划手册本身不代表真实业务动作发生。"
        ],
        [
          "CO99",
          "跨域建议",
          "最新合规FAQ曾建议正常退款1工作日结清，这属于无财务授权的建议。正式资金处理额度仍按财务职权域的有效控制项裁决。"
        ]
      ]
    }
  ],
