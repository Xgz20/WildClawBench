    "authority.yaml#AUTH-WITHDRAW": {
      "source": "authority.yaml",
      "source_sha256": "af9d5f29a0a342c6c2224b77993629a95e83da4c5bf1730c1df64bdf0dc3a85a",
      "locator": "/controls/AUTH-WITHDRAW",
