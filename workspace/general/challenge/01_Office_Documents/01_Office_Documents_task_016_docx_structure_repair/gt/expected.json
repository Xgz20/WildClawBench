{
  "status": "independently_read_clean_original_before_reference",
  "clean_sha256": "087f49ebdf03425f58739af75970a79ccc8b8474521ed31b9fc9e07329cd9f2e",
  "protected": {
    "paragraphs": {
      "P0001": "交付归档与复核手册",
      "P0002": "澄岚服务台 文档基准 CL-SYN-016 版本3.1 判断时点2026年10月1日。所有角色、样例记录、数值与批注均为合成材料。本手册说明交付资料如何登记、复核和归档，适用于文档管理练习，不构成真实业务批准。",
      "P0003": "交付负责人应先确认记录范围、状态和责任人，再组织复核。材料齐备与结论成立是两件事：收到文件只表示收到文件，发现一个正确数字也不能代替核对它所属的批次、期间和口径。未取得的证据继续写明待确认。",
      "P0004": "本文用连续章节描述流程，用附录保存字段约定与例子。表题和正文中的表号相互对应，目录链接用于定位章节。表格中的零、空白和“待复核”各有含义，任何交接版本都应保留这些区别。",
      "P0005": "原有批注记录历史复核问题。批注仍存在不表示问题已经解决，修改文档样式也不表示办理状态发生变化。复核人需要沿着批注所在文字理解问题，不能只从批注列表猜测它指向哪里。",
      "P0006": "读者先查看适用范围与角色分工，再按交付批次定位资料和记录。",
      "P0007": "遇到相互矛盾的记录时，保留各自出处及尚缺证据，不自行替任何一方作确认。",
      "P0008": "本版本只说明纸面流程与固定样例，不包含真实账号、交易指令或对外发送权限。",
      "P0009": "目录",
      "P0010": "目的与适用范围",
      "P0011": "本手册管理的是交付材料之间的对应关系。一个批次应能从登记表找到原文件，从复核记录找到证据位置，再从归档清单回到同一版本。仅能打开文件，不能证明这条对应关系已经建立。",
      "P0012": "适用对象包括交付负责人、复核人和归档管理员。各角色只在本文列明的职责内处理资料，不能因为持有文档副本就代替业务负责人确认事实。任务边界之外的审批、发布和交易不在本手册范围内。",
      "P0013": "业务正文采用原有术语和记录状态。“待复核”表示没有完成规定的检查，“已登记”仅表示登记动作完成；两者都不能自动改写为通过。资料不齐时应说明缺口，而不是删除含缺口的记录。",
      "P0014": "版本整理应保持完整材料链。标题、表题或目录出现错误时，应修复其结构关系，同时保留正文和历史复核意见。用另一个说法重新概括整段内容，可能使原有证据位置失去作用。",
      "P0015": "同一批次的文件名、记录编号和版本号应相互对应；简称不能替代唯一编号。",
      "P0016": "临时副本只用于查看或核对，不能直接成为已发布的交付版本。",
      "P0017": "记录中未提供的事实继续保留未知，不根据文件名称补充办理结果。",
      "P0018": "查不到对应材料时先登记缺口，保留已知记录及其原始位置。",
      "P0019": "复核意见应落到具体文字或数据，避免只写“已看过”“没问题”。",
      "P0020": "操作记录应写明实际发生的动作，计划、建议和执行分别记录。",
      "P0021": "角色与责任边界",
      "P0022": "职责表用来确定谁负责哪项检查。角色承担检查责任，不等于拥有改变业务结果的权限。归档管理员可以指出材料缺项，但不能把待确认的审批改为通过。交付负责人可以组织补齐资料，不能代替复核人签署独立结论。",
      "P0023": "同一人兼任多个角色时，仍应分别记录所做动作及依据。不能把一次登记描述为两次独立复核，也不能用后一次整理的结果覆盖前一次出现的问题。历史记录用于解释版本形成的过程。",
      "P0024": "责任转交需要明确接收范围。接收人应知道哪些材料已经核对、哪些只是登记、哪些仍需业务方确认。没有写明的事项不会因转交而自动完成，原责任人也不应删除尚未解决的意见。",
      "P0025": "表  角色责任与禁止代办事项",
      "P0026": "职责对应具体动作，不能只留下角色名称而没有检查对象。",
      "P0027": "兼任角色应保留各次动作记录，不虚构独立复核次数。",
      "P0028": "遇到授权缺口时提交确认请求，未得到答复前保留原状态。",
      "P0029": "资料接收与登记",
      "P0030": "接收资料时先记录材料标识、版本和覆盖范围，再核对内容。一个文件可能包含多个批次，也可能只覆盖同一批次中的部分字段。登记范围要据实际文件判断，不能由名称中的“完整”“最终”等词替代。",
      "P0031": "样例登记表中的M04处于待补充状态。这个状态不表示资料已经丢失，也不表示可以删除该行。后续收到补充材料时，应把新材料与M04建立关系，并说明它补充的是哪个字段或期间。",
      "P0032": "原始文件保持可回查的版本。收到内容不同但名称相同的文件时，不直接覆盖旧副本；登记两者的差异和接收时间，再由负责角色确认当前应引用哪一份。时间较新不必然代表内容有效。",
      "P0033": "表  接收材料登记样例",
      "P0034": "同名而内容不同的文件分别登记，不据文件名猜测替代关系。",
      "P0035": "空白版本仍是缺失信息，不能补成0或擅定为最新版本。",
      "P0036": "登记清单只说明接收情况，不构成内容有效性或审批通过证明。",
      "P0037": "记录核验",
      "P0038": "字段与批次范围",
      "P0039": "本章先确认字段和批次是否一致，再讨论数值是否合理。把两个不同批次的数值放在同一行，可能得到看似完整的结果，却无法说明任何一个批次的真实状态。复核记录应保留原材料中的批次键。",
      "P0040": "同名字段不一定具有同一口径。例如“收到件数”可能按文件数统计，“样本数量”可能按业务记录统计。核对时应写清单位与对象，不能因为两者数值相同就认定它们代表同一件事。",
      "P0041": "缺失字段不参加已有样本的事实断言。复核人可以计算已提供记录的比例，但必须说明分母来自哪里。不能把未填写项当作确定的否，也不能把部分样本的观察推广到全部业务。",
      "P0042": "一次核对的记录要求",
      "P0043": "一次核对至少记录材料版本、对象范围、定位和结果。定位应能使另一位读者找到相同内容；只写文件名或“见附件”不足以区分同一文档内的不同表格。复核结论与证据位置一同保存。",
      "P0044": "没有发现矛盾只表示本次已检查范围内未发现问题，不能扩大为整份材料没有任何缺陷。复核范围之外的字段仍按原状态处理，后续发现的问题也应继续记录。",
      "P0045": "先确认单位、期间、批次与字段定义，再比较数字。",
      "P0046": "引用范围应足以重做同一检查，不用含糊位置代替证据。",
      "P0047": "发现口径不一致时保留双方来源，不通过删掉一方来制造一致。",
      "P0048": "检查未覆盖的部分继续标明未覆盖，不补写“全部通过”。",
      "P0049": "采样与复核",
      "P0050": "本节接续记录核验章，说明采样记录的解释范围，不构成新章。样本批次按A至F分别保存，样本数量、发现项和状态属于同一行记录。不能把某一列单独排序后与其它列重新拼合。",
      "P0051": "B批次的发现项为0，E批次的发现项为空白。前者表示样例中记录为零，后者表示没有提供该值；两者不能在样式整理时合并。空白也不应据其它批次的平均值补齐。",
      "P0052": "发现项不是缺陷已经修复的数量。复核人还需要说明发现项的具体内容、负责角色与未决状态。将发现数改为零，只会破坏原始观察，不会使问题实际消失。",
      "P0053": "表  采样复核记录",
      "P0054": "各列按原记录成行移动，不能只重排其中一列。",
      "P0055": "零值和缺失分别保留，数字显示格式不承担事实补全功能。",
      "P0056": "样本结果只支持已给批次与字段，不能自动代表总体质量。",
      "P0057": "交接办理顺序",
      "P0058": "办理步骤",
      "P0059": "交接按下列顺序推进，每一步都留下实际状态。步骤编号用于指明办理先后，不代表前一项已经完成。若某一步缺少证据，应保留该步骤及缺口，不通过重新编号把它从流程中隐藏。",
      "P0060": "办理人与复核人应使用同一批次版本。发现接收范围变化时，应先更新范围记录，再继续后续检查。不能把范围不同的两次检查合并描述为同一次完整复核。",
      "P0061": "登记交接对象、批次和版本，确认材料清单中的实际接收情况。未提供的附件保持待补充状态，不能从名称推定已经收到。",
      "P0062": "核对材料中的字段、单位和期间，记录本次检查覆盖的范围。发现口径不同则保存双方出处，交由负责角色进一步确认。",
      "P0063": "复核采样记录中的成行关系，保留发现项、零值及空白。样本观察不能单独证明问题已解决，也不能替代实际修复记录。",
      "P0064": "整理尚未完成的事项及负责角色，写明需要补充的材料或确认结果。没有得到答复的事项继续保留未知，不能写成默认同意。",
      "P0065": "形成待接收的交接版本并检查引用位置，把保存位置交给接收人。保存交接文件不等于已经发送、批准或完成业务执行。",
      "P0066": "第三步应使用表  的采样复核记录核对批次与发现项，不能引用角色职责表来替代样本证据。",
      "P0067": "交接记录与原材料可以相互回查，但不能用交接结论覆盖原材料。",
      "P0068": "办理受阻时说明实际阻碍，不虚构完成时间或接收确认。",
      "P0069": "保留范围与访问",
      "P0070": "范围记录",
      "P0071": "保留范围按资料类别区分。样例中的天数为本手册固定参数，不代表任何真实系统已经配置相同规则。复核应核对当前材料中规定的范围，而不是猜测客户端或服务器的实际设置。",
      "P0072": "到期状态与删除结果分别记录。一个记录超过保留天数，不能单独证明相关副本已实际删除；本手册也没有提供恢复保证。需要判断实际状态时，应另行取得对应系统证据。",
      "P0073": "访问角色的定义与第二章一致。获得归档副本不等于获得修改审批、补填事实或对外发布的权限。发生角色冲突时保留原设置，提交负责角色确认。",
      "P0074": "表  资料类别与保留范围",
      "P0075": "访问复核",
      "P0076": "记录保留天数时，同时保留资料类别和范围说明。把所有类别统一成一个数，会丢失原有约定。临时导出也不应因为便于查看就被登记为长期归档版本。",
      "P0077": "保留天数属于规定范围，不冒充已经发生的删除动作。",
      "P0078": "未提供恢复结果时，不承诺可以恢复，也不声称所有副本都不存在。",
      "P0079": "异常与未决事项",
      "P0080": "分级依据",
      "P0081": "异常分级帮助确定复核先后。它只对本次材料中的现象作分类，不直接证明业务损失已经发生。分级记录应保留可观察现象与待确认影响，不能把猜测写成事实。",
      "P0082": "同一事项可能包含多类缺口。已有一项严重问题时，仍应记录其它尚未满足的条件。不能因为某一项已经阻止办理，就把其余未知事项写成通过。",
      "P0083": "表  异常分级与继续条件",
      "P0084": "未决记录",
      "P0085": "未决事项应说明缺少什么以及谁能补充。记录“待确认”不是不做处理，而是明确当前证据的边界。后续拿到材料后，应继续沿用同一事项编号记录处理过程，不以新编号掩盖历史问题。",
      "P0086": "涉及保留范围的异常应对照表  的资料类别与保留范围逐项确认，不能把“到期”直接等同于“已删除”。",
      "P0087": "分级由给定现象决定，不按人员级别或表达强硬程度决定。",
      "P0088": "已有严重问题不会使其他缺口自动变成已满足。",
      "P0089": "补充材料改变结论时，保留原观察和新的判断依据。",
      "P0090": "交接记录与证据",
      "P0091": "可回查的位置",
      "P0092": "交接记录把结论与材料位置连接起来。位置可以是章节、表格、具体字段或固定记录ID，但应使另一位读者找到同一对象。只写“见文件”不足以区分同一文件中的多条记录。",
      "P0093": "引用目标必须与当前主张有关。一个位置真实存在，也可能不支持所写结论。例如角色表不能证明某个批次的样本数量，保留范围表也不能证明一个删除动作已经执行。",
      "P0094": "保存证据索引时应保留未决范围。正文、表格与交接结论不一致时，不把其中一个悄悄删除；应明确矛盾所在及需要确认的内容，让接收人知道哪些部分尚不能据以办理。",
      "P0095": "引用应随当前交接版本复查。标题变动、目录刷新或段落重排都可能影响原位置，因此不能只凭上一个版本中的页码断言引用仍然有效。材料标识和业务对象可帮助读者重新定位。",
      "P0096": "处理异常的职责与未决要求见第  章。该引用应指向异常与未决事项，不应用相邻章节的位置替代。",
      "P0097": "每条主要结论有明确对象、材料范围和可回查位置。",
      "P0098": "主张与引用目标逐条核对，不因目标可打开就认为已经支持。",
      "P0099": "保持输入版本和交接版本之间的对应关系，不能混用旧位置。",
      "P0100": "发现引用失效时记录具体对象，修复后再确认链接与内容。",
      "P0101": "证据仍不充分的结论保留限定条件，不用格式整理来消除未知。",
      "P0102": "复核意见与变更",
      "P0103": "意见的办理状态",
      "P0104": "复核意见用于描述需要核对的具体问题。意见正文、作者、时间和所指文字一同构成历史记录；脱离锚点只保留一句话，可能使后来读者误解问题的范围。",
      "P0105": "格式调整不改变意见的办理状态。把正文改成新的样式、重建表题或刷新目录，不能单独证明意见已经解决。未经确认不能删除意见、改写为同意或伪造解决时间。",
      "P0106": "新增业务内容需要有来源和范围。当前任务只整理现有材料时，不能自行补充审批结论或未提供的数据。确有需要时，将建议作为待确认事项交给负责角色，不混入原有事实。",
      "P0107": "发生文字差异时先确认它是否属于允许更新的结构显示。目录条目、自动编号及引用显示可能随结构修复而变化；正文事实、原始表格值和批注意见仍应保留。",
      "P0108": "若工具不能处理某项结构，应明确说明限制与剩余检查，不能在交接说明中声称已经全部完成。读者应能区分已验证项目与只作了形式调整的项目。",
      "P0109": "保留批注意见的作者、时间、文字和所指范围，不将其改为新的批准。",
      "P0110": "允许更新的结构显示与不得改写的事实分别核对。",
      "P0111": "新建议与原始事实分开表达，不用建议替代缺失证据。",
      "P0112": "对尚未完成的结构检查写明对象，不以“已修复”自述代替核验。",
      "P0113": "办理状态改变时保存实际依据，未取得依据前沿用原状态。",
      "P0114": "版本与归档边界",
      "P0115": "版本核对",
      "P0116": "版本号用于区分可回查的交付状态，不直接说明审批效力。样例中的R03仍待确认，不能因为它的编号较新就把它当作已批准版本。版本选择应依据明确状态和材料范围。",
      "P0117": "归档前应确认当前引用的材料属于同一版本集合。来自不同日期的表格可以共同保留，但需要标明差异与适用范围，不能把它们合并成一个不存在的统一确认结果。",
      "P0118": "已经登记的历史版本继续保留其状态与对应位置。新的整理版本应说明修改范围，避免接收人把样式修复误当作业务事实或授权发生变化。",
      "P0119": "表  版本核对记录",
      "P0120": "版本号和办理状态共同记录，不能互相代替。",
      "P0121": "保持历史与当前的区别，不通过覆盖文件隐藏变更。",
      "P0122": "未有明确批准记录时，不补写“已批准”或实际执行结果。",
      "P0123": "字段约定与解释",
      "P0124": "唯一标识用于保持记录之间的关系，不能只把它看作排版文本。材料ID、批次键、表格标题和意见锚点承担不同作用；改变其中一个值可能使其它位置仍可显示，却已经指向另一对象。",
      "P0125": "空值、零值和“不适用”分别记录。零是一个已给数值，空值表示未提供，“不适用”表示该字段在本情境中没有对应对象。把它们统一为短横线，会使后来读者无法判断原意。",
      "P0126": "状态词应与原记录一致。“已登记”只说明登记动作，“待复核”表明检查尚未完成，“待确认”说明当前缺少确定结论。这些词都不能自动变为“通过”或“拒绝”。",
      "P0127": "同一术语需要在同一范围内解释。若两个材料给出不同定义，应保留各自定义与出处，指出需要确认的差异。不能选择更方便的一种定义并把另一种直接删除。",
      "P0128": "数值单位也是数据的一部分。表格或正文已经给出单位时，应按原单位解释。这里不提供单位推断、金额换算或补值的授权，不能为使版面整齐而改变记录数值。",
      "P0129": "唯一标识不改写，不用显示序号替代业务标识。",
      "P0130": "零值仍写零，缺失仍保留缺失，不据其它行猜补。",
      "P0131": "状态沿用原记录，样式统一不承担状态变更功能。",
      "P0132": "术语冲突保留出处，后续确认需要另外的依据。",
      "P0133": "数值和单位成对核对，不能只比较数字部分。",
      "P0134": "复查与交付说明",
      "P0135": "复查应从实际交付文件出发，检查能否打开、阅读与继续维护。聊天中的说明可以帮助理解过程，但不能替代文件中的实际结构，也不能证明未保存的修改已经进入交付版本。",
      "P0136": "检查标题层级时，同时核对它在正文与目录中的位置。检查表题时，沿着正文中的引用找到对应表格。检查批注时，确认意见仍绑定原有文字，而不只是评论文件仍存在。",
      "P0137": "结构显示需要更新时，应说明所用工具和实际验证范围。不同编辑器可能在域更新或字体映射上存在差异，因此不能把某个预览结果说成所有编辑器都已验证通过。",
      "P0138": "交付说明写清文件名称、修改范围、可回查位置和剩余事项。没有完成的检查应明确列出，不补写“已经全面验证”。原材料只读保留，新的交付版本与原输入分开存放。",
      "P0139": "接收人应能够继续维护这份文档。新增同级标题或后续表格时，原生编号链应按约定延续；如果只能通过手工改数字保持表面一致，就还没有建立稳定的文档结构。",
      "P0140": "从实际文件核验内容和结构，避免只依据自述完成状态。",
      "P0141": "目录、标题、表题和引用应指向同一业务对象。",
      "P0142": "批注的文字与锚点都要检查，不只清点批注条数。",
      "P0143": "说明打开和更新方式，区分实际验证与尚未验证的兼容性。",
      "P0144": "保留输入副本与修改记录，便于下一位读者重做检查。",
      "P0145": "附录 A 交接记录字段",
      "P0146": "本附录给出交接记录应包含的字段含义，供读者核对已有材料。它不要求为未提供字段补填内容，也不表示某个交付批次已经具备全部材料。检查时应逐项判断是否已经有对应记录。",
      "P0147": "对象字段说明当前记录针对哪个批次或材料；范围字段说明本次核对覆盖什么；版本字段用来找到同一文件副本；定位字段指向具体文字或表格。四者结合才能让另一位读者重做同一检查。",
      "P0148": "结果字段使用原有状态并附依据。没有结论时保留待确认，不用空白“结果”栏暗示通过。后续动作字段说明谁可提供什么材料，不能替别人承诺实际办理时间。",
      "P0149": "记录之间出现差异时，应保留能解释差异的原始信息。只保留合并后的结果，可能使接收人看不到过去的未决事项。附录字段用于提高可回查性，不能替代业务结论。",
      "P0150": "对象字段保留唯一标识及原称谓，避免同名对象混淆。",
      "P0151": "范围字段说明覆盖与未覆盖部分，不使用“全部”等无依据扩大词。",
      "P0152": "版本字段指向实际保存的副本，不据文件名猜测效力。",
      "P0153": "定位字段可以落到章节、表格、记录ID或具体字段。",
      "P0154": "结果字段区分事实、推断和未知，保留必要的限定。",
      "P0155": "后续动作字段写明负责角色与需要补充的材料。",
      "P0156": "备注字段保留影响理解的范围说明，不承担批准功能。",
      "P0157": "附录 B 三种记录状态",
      "P0158": "“已登记”是对登记动作的描述。它可以与待复核、待确认等后续状态并存，不能单独证明内容真实、范围完整或意见已经解决。解读表格时应连同范围列和说明一起查看。",
      "P0159": "“待复核”表示规定的检查尚未完成。读者不应把它理解成已经发现错误，也不能理解成没有发现问题。实际发现项和办理状态仍需依据对应记录判断。",
      "P0160": "“待确认”表示当前材料不足以支持确定结论。它并不是默认同意，也不是默认拒绝。只有在新的材料或明确答复到达后，负责角色才能按实际依据更新状态。",
      "P0161": "文档整理不能替代这些业务动作。统一字体、修复编号和更新目录可以提高可读性，但不能使审批生效、使资料补齐或使问题解决。交接说明应保留这一边界。",
      "P0162": "已登记不等于已通过，需继续查看其余字段与证据。",
      "P0163": "待复核不等于已失败，不能凭状态补写缺陷事实。",
      "P0164": "待确认不等于默认同意，也不等于默认拒绝。",
      "P0165": "修改状态需要实际依据，不从排版变化推导业务变化。",
      "P0166": "多个状态同时出现时，分别解释它们描述的动作和对象。",
      "P0167": "状态记录发生变化时，保留先前状态及变更依据。",
      "P0168": "未取得新的材料或答复时，不为追求完整而改写原状态。",
      "P0169": "附录 C 复查顺序",
      "P0170": "复查从原输入与交付版本的对应关系开始。先确认文件范围，再确认正文、表格和意见是否保留，最后核对标题、目录与引用。只看最后一页或某个正确数字，不能替代对整份材料的检查。",
      "P0171": "原有段落与数据保持后，结构修复的结果才有可比较的依据。若整理过程同时改写业务内容，就难以区分结论变化来自事实修改还是结构修改，因此不应将两类动作混在一起。",
      "P0172": "引用检查需要沿实际目标核对。一个书签或位置存在，并不保证它指向正确对象。读者应比较目标标题、表格内容和正文主张，必要时回到材料清单确认版本。",
      "P0173": "交付时写明实际完成的检查及剩余事项。未在某个编辑器中打开验证，就不描述成已经验证；没有确认的业务状态也继续沿用原记录。文件与说明应能够相互支持。",
      "P0174": "确认输入与交付范围一致，保留所有原始材料。",
      "P0175": "逐项对照正文、数据和批注意见，不仅比较页数。",
      "P0176": "核对标题层级和连续编号，确保后续可以继续维护。",
      "P0177": "检查目录条目、跳转链接和页码，避免只保留外观。",
      "P0178": "核对表题顺序与正文引用，确认它们指向同一张表。",
      "P0179": "记录实际使用的更新方式，保留尚未验证的兼容性范围。",
      "P0180": "保存修复日志，使后续读者能找到具体修改位置。"
    },
