      "source": "handoff.docx",
      "source_sha256": "80cef74cde39fd4ad8357b28823d25013c6cc38c254fb7a8074719a77e761d38",
      "locator": "table:1/row:2/cell:3",
      "text": "16:00"
    },
    "handoff.docx#table:1/row:2/cell:4": {
      "source": "handoff.docx",
      "source_sha256": "80cef74cde39fd4ad8357b28823d25013c6cc38c254fb7a8074719a77e761d38",
      "locator": "table:1/row:2/cell:4",
      "text": "依赖状态可查，缺项单独登记"
    },
    "handoff.docx#table:1/row:3/cell:1": {
