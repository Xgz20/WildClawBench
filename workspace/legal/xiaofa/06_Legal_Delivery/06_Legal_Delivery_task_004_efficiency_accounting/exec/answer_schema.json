{
  "version": 1,
  "facts_fields": {
    "baseline_minutes": {
      "type": "number"
    },
    "ai_wall_minutes": {
      "type": "number"
    },
    "time_saved_percent": {
      "type": "number"
    },
    "speedup": {
      "type": "number"
    },
    "first_pass_rate": {
      "type": "number"
    },
    "final_pass_rate": {
      "type": "number"
    },
    "ai_service_cost": {
      "type": "number"
    },
    "ai_human_cost": {
      "type": "number"
    },
    "ai_total_cost": {
      "type": "number"
    },
    "cost_per_passed_case": {
      "type": "number"
    },
    "measured_accuracy_from_testimonial": {
      "type": "boolean"
    }
  },
  "conventions": "金额为元；日期YYYY-MM-DD；unknown用null；数组无序不重复；source locator须为材料段号、条款、页码、图中文字位置或视频时间码。数字容差0.005。",
  "output": {
    "facts": "按facts_fields逐项填入，不在此提供答案",
    "sources": "每个fact key对应[{file:原始相对路径,locator:具体位置}]",
    "input_sha256": "原始相对文件路径到实际SHA-256的映射"
  }
}
