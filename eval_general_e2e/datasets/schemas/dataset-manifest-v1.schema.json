{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:dataset-manifest:v1",
  "title": "WildClawBench General E2E Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "bundle_protocol",
    "dataset_id",
    "created_at",
    "generated_by",
    "digest_algorithm",
    "dataset_digest",
    "source",
    "schema",
    "selection",
    "statistics",
    "task_count",
    "tasks"
  ],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:dataset-manifest:v1"},
    "schema_version": {"const": 1},
    "contract_version": {"const": "general-e2e-contract-v1"},
    "bundle_protocol": {"const": "general-e2e-package-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "minLength": 1},
    "digest_algorithm": {"const": "wildclawbench.dataset-manifest-sha256/v1"},
    "dataset_digest": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "revision_scope", "task_registry_path", "task_registry_sha256"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "revision_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "task_registry_path": {"type": "string", "minLength": 1},
        "task_registry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_root", "include_tags", "exclude_tags", "ordering"],
      "properties": {
        "task_root": {"type": "string"},
        "include_tags": {"type": "array", "items": {"type": "string"}},
        "exclude_tags": {"type": "array", "items": {"type": "string"}},
        "ordering": {"const": "source_path_posix_ascending"}
      }
    },
    "statistics": {"type": "object"},
    "task_count": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "treeEntry": {
      "type": "object",
      "required": ["kind", "path", "mode"],
      "properties": {
        "kind": {"enum": ["file", "directory", "symlink"]},
        "path": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "link_target": {"type": "string"}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "root", "entries", "sha256"],
      "properties": {
        "algorithm": {"const": "wildclawbench.dataset-tree-sha256/v1"},
        "root": {"type": "string", "minLength": 1},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/treeEntry"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order", "task_id", "name", "category", "difficulty", "modality",
        "timeout_seconds", "grading_type", "grading_weights", "tags",
        "source", "bundle", "digests", "materials"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "category": {"type": "string", "minLength": 1},
        "difficulty": {"type": "string", "minLength": 1},
        "modality": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "grading_type": {"enum": ["automated", "hybrid", "llm_judge"]},
        "grading_weights": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "object"},
        "bundle": {"type": "object"},
        "digests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution", "private_scoring"],
          "properties": {
            "execution": {"$ref": "#/$defs/tree"},
            "private_scoring": {"$ref": "#/$defs/tree"}
          }
        }
      }
    }
  }
}
