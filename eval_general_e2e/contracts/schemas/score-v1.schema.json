{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:score:v1",
  "title": "General E2E task score v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "identity", "dataset", "execution", "judge", "components", "evaluation", "result"],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:score:v1"}, "schema_version": {"const": 1},
    "identity": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/taskIdentity"}, "dataset": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/dataset"},
    "execution": {"type": "object", "additionalProperties": false, "required": ["record_path", "record_sha256", "attempt_id", "business_status"], "properties": {"record_path": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/relativePath"}, "record_sha256": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/sha256"}, "attempt_id": {"type": "string", "minLength": 1}, "business_status": {"enum": ["completed", "candidate_error", "timeout", "infrastructure_error", "cancelled"]}}},
    "judge": {"type": "object", "additionalProperties": false, "required": ["protocol", "model", "reasoning_effort", "attempt_id"], "properties": {"protocol": {"enum": ["codex-agent-judge-v1", "api-judge-v1", "not-required"]}, "model": {"type": ["string", "null"]}, "reasoning_effort": {"type": ["string", "null"]}, "attempt_id": {"type": "string", "minLength": 1}}},
    "components": {"type": "object", "additionalProperties": false, "required": ["rules", "semantics"], "properties": {"rules": {"$ref": "#/$defs/component"}, "semantics": {"$ref": "#/$defs/component"}}},
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["status", "criteria", "error"],
      "properties": {"status": {"enum": ["completed", "partial", "evaluation_error"]}, "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}}, "error": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/error"}}
    },
    "result": {"type": "object", "additionalProperties": false, "required": ["valid", "total_score", "invalid_reason"], "properties": {"valid": {"type": "boolean"}, "total_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "invalid_reason": {"type": ["string", "null"]}}}
  },
  "$defs": {
    "component": {"type": "object", "additionalProperties": false, "required": ["status", "score"], "properties": {"status": {"enum": ["completed", "not_required", "evaluation_error"]}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["key", "weight", "status", "score", "reason", "evidence"],
      "properties": {"key": {"type": "string", "minLength": 1}, "weight": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"enum": ["judged", "not_applicable", "unresolved"]}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/evidence"}}}
    }
  }
}
