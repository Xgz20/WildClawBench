{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:common:v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "unit_id", "task_id", "attempt_id"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1}
      }
    },
    "batchScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "unit_id"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["event_ids"]}]
    }
  }
}
