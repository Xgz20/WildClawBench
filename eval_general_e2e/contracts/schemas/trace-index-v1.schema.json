{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildclawbench:schema:general-e2e:trace-index:v1",
  "title": "General E2E trace index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "identity", "transcript", "raw_trace", "completeness", "calls"],
  "properties": {
    "schema_id": {"const": "urn:wildclawbench:schema:general-e2e:trace-index:v1"}, "schema_version": {"const": 1},
    "identity": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/taskIdentity"},
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["thread_id", "turn_id", "session_id", "cwd", "lifecycle_generation"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "turn_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "lifecycle_generation": {"type": "string", "minLength": 1}
      }
    },
    "transcript": {
      "allOf": [{"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/artifact"}],
      "type": "object", "required": ["event_count"], "properties": {"event_count": {"type": "integer", "minimum": 0}}
    },
    "raw_trace": {"type": "array", "items": {"$ref": "urn:wildclawbench:schema:general-e2e:common:v1#/$defs/artifact"}},
    "raw_event_range": {
      "type": "object", "additionalProperties": false,
      "required": ["first_sequence", "last_sequence", "event_count"],
      "properties": {
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 1}
      }
    },
    "normalization": {
      "type": "object", "additionalProperties": false,
      "required": ["native_event_count", "normalized_event_count", "filtered_native_event_count", "compatibility_profiles"],
      "properties": {
        "native_event_count": {"type": "integer", "minimum": 1},
        "normalized_event_count": {"type": "integer", "minimum": 1},
        "filtered_native_event_count": {"type": "integer", "minimum": 0},
        "compatibility_profiles": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true
        }
      }
    },
    "completeness": {
      "type": "object", "additionalProperties": false, "required": ["status", "omitted_event_count", "missing"],
      "properties": {"status": {"enum": ["complete", "partial", "unavailable"]}, "omitted_event_count": {"type": "integer", "minimum": 0}, "missing": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "calls": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["call_id", "call_sequence", "result_sequence"],
        "properties": {"call_id": {"type": "string", "minLength": 1}, "call_sequence": {"type": "integer", "minimum": 0}, "result_sequence": {"type": ["integer", "null"], "minimum": 0}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"completeness": {"properties": {"status": {"const": "complete"}}}}},
      "then": {"properties": {"raw_trace": {"minItems": 1}}}
    }
  ]
}
