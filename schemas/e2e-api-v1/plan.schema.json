{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wildclawbench:e2e-api:v1:plan",
  "title": "WildClawBench E2E API v1 plan",
  "type": "object",
  "required": [
    "selection",
    "units"
  ],
  "properties": {
    "selection": {
      "type": "object",
      "required": [
        "scenario"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "harness",
          "model"
        ],
        "properties": {
          "harness": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "workbuddy_full_access": {
            "type": "boolean"
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "execution_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "runs": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_override": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
