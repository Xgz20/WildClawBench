{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wildclawbench:e2e-api:v1:plan",
  "title": "WildClawBench E2E API v1 plan",
  "type": "object",
  "required": [
    "selection",
    "units"
  ],
  "properties": {
    "selection": {
      "type": "object",
      "required": [
        "scenario"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "harness",
          "model"
        ],
        "properties": {
          "harness": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "workbuddy_full_access": {
            "type": "boolean"
          },
          "preprocessing": {
            "type": "object",
            "required": ["default", "overrides"],
            "properties": {
              "default": { "$ref": "#/definitions/preprocessingRecipe" },
              "overrides": {
                "type": "object",
                "additionalProperties": { "$ref": "#/definitions/preprocessingRecipe" }
              }
            },
            "additionalProperties": false
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "execution_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "runs": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_override": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "preprocessingRecipe": {
      "type": ["object", "null"],
      "required": ["version_id", "version", "name", "steps"],
      "properties": {
        "version_id": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["kind", "asset", "timeout"],
            "properties": {
              "kind": { "enum": ["skill", "plugin", "acode", "powershell"] },
              "asset": { "type": "object" },
              "timeout": { "type": "integer", "minimum": 10, "maximum": 600 }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
