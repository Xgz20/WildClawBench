{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wildclawbench:e2e-api:v1:plan",
  "title": "WildClawBench E2E API v1 plan",
  "type": "object",
  "required": [
    "selection",
    "units"
  ],
  "properties": {
    "selection": {
      "type": "object",
      "required": [
        "scenario"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "harness",
          "model"
        ],
        "properties": {
          "harness": {
            "type": "string"
          },
          "template_binding": {
            "type": "object",
            "required": [
              "id",
              "namespace",
              "image_digest",
              "profile_id",
              "waa_revision"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "namespace": {
                "type": "string"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "profile_id": {
                "type": "string"
              },
              "waa_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{7,40}$"
              }
            },
            "additionalProperties": false
          },
          "model": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "workbuddy_full_access": {
            "type": "boolean"
          },
          "preprocessing": {
            "type": "object",
            "required": [
              "default",
              "overrides"
            ],
            "properties": {
              "default": {
                "$ref": "#/definitions/preprocessingRecipe"
              },
              "overrides": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/preprocessingRecipe"
                }
              },
              "prompt_directives": {
                "$ref": "#/definitions/promptDirectives"
              },
              "prompt_plugin_validation": {
                "enum": [
                  "installed-plugin-v1"
                ]
              }
            },
            "additionalProperties": false
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_directives": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/promptDirectives"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "execution_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "runs": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_override": {
      "type": "integer",
      "minimum": 1
    },
    "failure_retention_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "description": "平台新批次默认1800秒；旧冻结计划缺失字段时按0。"
    }
  },
  "definitions": {
    "preprocessingRecipe": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "version_id",
        "version",
        "name",
        "steps"
      ],
      "properties": {
        "version_id": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "asset",
              "timeout"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "skill",
                  "plugin",
                  "acode",
                  "powershell"
                ]
              },
              "asset": {
                "type": "object"
              },
              "timeout": {
                "type": "integer",
                "minimum": 10,
                "maximum": 600
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "promptDirectives": {
      "type": "object",
      "required": [
        "default",
        "overrides"
      ],
      "properties": {
        "default": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
