{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wildclawbench:e2e-api:v1:event",
  "title": "WildClawBench E2E API v1 event",
  "type": "object",
  "required": [
    "batch_id",
    "cursor",
    "at",
    "event_type",
    "payload"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "cursor": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "execution_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
