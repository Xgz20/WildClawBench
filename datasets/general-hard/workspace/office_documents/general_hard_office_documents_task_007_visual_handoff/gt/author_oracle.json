{
  "schema_version": "h007-author-oracle/v1",
  "status": "pending_independent_annotations",
  "source": {
    "title": "澄桥服务中心发布交接稿",
    "organization": "澄桥服务中心",
    "introduction": "本稿供受理岗、复核岗和交接负责人核对本批发布准备。内容为合成业务材料，当前只制作交接稿，不代表已执行发布、通知或权限变更。",
    "pages": [
      {
        "sections": [
          {
            "id": "history",
            "title": "一 历史演练记录",
            "paragraphs": [
              {
                "id": "history_window",
                "text": "演练回放时间为周一09:00。已完成记录不得改写。"
              }
            ]
          },
          {
            "id": "preparation",
            "title": "二 本批交接准备",
            "paragraphs": [
              {
                "id": "batch_scope",
                "text": "本批由交接负责人统一收口状态，未完成依赖继续保留待办，不以文稿修订代替实际业务验收。"
              },
              {
                "id": "current_window",
                "text": "正式交接窗口为周一09:00。按窗口完成状态交接。"
              },
              {
                "id": "owner_pair",
                "text": "准备责任岗为值班小组A；后备岗为值班小组A。"
              },
              {
                "id": "customer_promise",
                "text": "通知客户时承诺当日一定结案。依赖项未完成时应同步待办与当前状态。"
              },
              {
                "id": "preparation_log",
                "text": "准备登记保留原批次号、实际联系时间与材料版本，不因修订说明重建批次。"
              }
            ]
          }
        ]
      },
      {
        "sections": [
          {
            "id": "coordination",
            "title": "三 协作时限",
            "paragraphs": [
              {
                "id": "coordination_intro",
                "text": "以下截止时间用于内部交接节点，岗位分别核对材料与回执，不把协作登记写成业务已经办结。"
              }
            ],
            "table": {
              "id": "coordination_table",
              "headers": [
                "协作环节",
                "责任岗位",
                "截止时间",
                "交接条件"
              ],
              "rows": [
                {
                  "id": "review_materials",
                  "values": [
                    "复核材料",
                    "资料专员",
                    "16:00",
                    "依赖状态可查，缺项单独登记"
                  ]
                },
                {
                  "id": "archive_receipt",
                  "values": [
                    "回执归档",
                    "归档专员",
                    "16:00",
                    "沿用历史归档登记口径"
                  ]
                }
              ]
            },
            "after": [
              {
                "id": "handoff_note",
                "text": "交接说明：提交后由下一岗接续办理。"
              },
              {
                "id": "archive_note",
                "text": "归档说明：提交后由下一岗接续办理。"
              },
              {
                "id": "handoff_boundary",
                "text": "交接材料只记实际状态和责任入口，未取得确认的事项保留待核，不补造回执。"
              }
            ]
          }
        ]
      },
      {
        "sections": [
          {
            "id": "release_order",
            "title": "四 放行与交接顺序",
            "paragraphs": [
              {
                "id": "step1",
                "text": "1 登记本批次状态。"
              },
              {
                "id": "step2",
                "text": "2 通知协作岗位。"
              },
              {
                "id": "step3",
                "text": "3 核对依赖回执。"
              },
              {
                "id": "step4",
                "text": "4 记录交接结果。"
              }
            ]
          },
          {
            "id": "retention",
            "title": "五 记录保留",
            "paragraphs": [
              {
                "id": "record_retention",
                "text": "发布记录保存期为180天；任何例外仍按已批准记录保留。"
              },
              {
                "id": "receipt_originals",
                "text": "未经负责人确认，不得删除任何回执原件。"
              }
            ]
          }
        ]
      }
    ]
  },
