DOCKER_IMAGE=wildclawbench-ubuntu:v1.3
DOCKER_IMAGE_ASTRONCLAW=wildclawbench-astronclaw-ubuntu:v0.2.9-eval.1
DOCKER_IMAGE_CLAUDECODE=wildclawbench-claudecode-ubuntu:v0.2-patched
# v0.4 pins AstronCode 0.0.13 and bundles Search/Fetch MCP plus the SearchBetter Skill.
DOCKER_IMAGE_ASTRONCODE=wildclawbench-astroncode-ubuntu:v0.4-ppt
# v0.1 = 官方底座 v0.0 + Codex CLI 0.146.0，需先 bash docker/codex/build.sh 构建。
# 未构建时改回 wildclawbench-codex-ubuntu:v0.0（Codex CLI 0.121.0）。
# 两个 tag 的结果不可混在同一批次比较：CLI 版本变了，工具协议与 token 口径都可能有差异。
DOCKER_IMAGE_CODEX=wildclawbench-codex-ubuntu:v0.1
# Optional HermesAgent image override and per-response output limit.
# Leave HERMES_MAX_TOKENS empty to use the model/provider default.
HERMES_DOCKER_IMAGE=wildclawbench-hermes-agent:v0.5
HERMES_MAX_TOKENS=
GATEWAY_PORT=18789
TMP_WORKSPACE=/tmp_workspace
 
TASKS_SUBDIR=tasks
OUTPUT_SUBDIR=output
 
DEFAULT_MODEL=openrouter/xxx
 
DEFAULT_PARALLEL=1
 
HTTP_PROXY_INNER=
HTTPS_PROXY_INNER=
NO_PROXY_INNER=

OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
JUDGE_MODEL=openai/gpt-5.4
JUDGE_MAX_TOKENS=1000
# Number of retries after an invalid Judge JSON response (default: 2).
WILDCLAW_JUDGE_RETRIES=2
WILDCLAW_GRADING_TIMEOUT_SECONDS=600
WILDCLAW_JUDGE_TIMEOUT_SECONDS=300
OPENROUTER_API_KEY=
BRAVE_API_KEY=

# AstronCode provider overrides are optional; empty values keep legacy OPENROUTER_* fallbacks.
ASTRON_API_KEY=
ASTRON_SPARK_API_KEY=
ONE_IFLYTEK_API_KEY=
ONE_IFLYTEK_BASE_URL=
# Optional override; defaults to the AstronCode production model catalog endpoint.
ASTRON_MODELS_BASE_URL=https://astroncode-api-prod.xf-yun.com/api/v1/astroncode_webserver/config-v1
ASTRONCODE_MODEL_PROVIDER=
# AstronCode rollout trace is enabled by default; set to 0 to disable export.
ASTRONCODE_TRACE_ENABLED=true

# Using a Custom Model Endpoint
# MY_PROXY_API_KEY=

# Lobster profile env keys (add values here for skills that need them)
# GEMINI_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=

# Task env
# 01_Productivity_Flow

# 02_Code_Intelligence

# 03_Social_Interaction

# 04_Search_Retrieval

# 05_Creative_Synthesis

# 06_Safety_Alignment
