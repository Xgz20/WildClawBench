+//! A streaming read handle whose file descriptor remains in a native-sandboxed
+//! worker. The controller never opens the requested data path itself.
+use std::io;
+use std::io::BufRead;
+use std::io::Write;
+use std::os::unix::fs::FileExt;
+use std::os::unix::fs::OpenOptionsExt;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncWriteExt;
+
+use crate::ExecServerRuntimePaths;
+use crate::FileSystemSandboxContext;
+use crate::file_read::FileReadBlock;
+use crate::fs_sandbox::FileSystemSandboxRunner;
+use crate::fs_sandbox::spawn_command;
+use codex_utils_path_uri::PathUri;
+
+pub const CONTROLLER_READ_ARG1: &str = "--astudio-controller-read";
+
+pub(crate) struct ControllerRead {
+    _child: tokio::process::Child,
+    input: tokio::process::ChildStdin,
+    output: tokio::io::BufReader<tokio::process::ChildStdout>,
+}
+
+impl ControllerRead {
+    pub(crate) async fn open(
+        runtime: ExecServerRuntimePaths,
+        path: &PathUri,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<Self> {
+        let context = crate::controller_boundary::context(sandbox)
+            .ok_or_else(|| io::Error::other("controller boundary is required"))?;
+        let mut command = FileSystemSandboxRunner::new(runtime)
+            .prepare_command(context)
+            .map_err(|error| io::Error::other(error.message))?;
+        let flag = command
+            .command
+            .last_mut()
+            .ok_or_else(|| io::Error::other("missing native file helper"))?;
+        if flag.as_str() != crate::CODEX_FS_HELPER_ARG1 {
+            return Err(io::Error::other("unexpected native file helper"));
+        }
+        *flag = CONTROLLER_READ_ARG1.into();
+        let mut child = spawn_command(command).map_err(|error| io::Error::other(error.message))?;
+        let input = child
+            .stdin
+            .take()
+            .ok_or_else(|| io::Error::other("missing controller read stdin"))?;
+        let output = child
+            .stdout
+            .take()
+            .ok_or_else(|| io::Error::other("missing controller read stdout"))?;
+        let mut reader = Self {
+            _child: child,
+            input,
+            output: tokio::io::BufReader::new(output),
+        };
+        reader.exchange(serde_json::json!({"path":path})).await?;
+        Ok(reader)
+    }
+
+    async fn exchange(&mut self, value: serde_json::Value) -> io::Result<serde_json::Value> {
+        let mut bytes = serde_json::to_vec(&value)?;
+        bytes.push(b'\n');
+        self.input.write_all(&bytes).await?;
+        self.input.flush().await?;
+        let mut line = String::new();
+        let length = tokio::time::timeout(
+            std::time::Duration::from_secs(30),
+            self.output.read_line(&mut line),
+        )
+        .await
+        .map_err(|_| {
+            io::Error::new(io::ErrorKind::TimedOut, "sandboxed read helper timed out")
+        })??;
+        if length == 0 || length > 2 * crate::FILE_READ_CHUNK_SIZE + 1024 {
+            return Err(io::Error::other("invalid sandboxed read helper response"));
+        }
+        let reply: serde_json::Value = serde_json::from_str(&line)?;
+        if let Some(error) = reply.get("error") {
+            return Err(reply
+                .get("os_error")
+                .and_then(serde_json::Value::as_i64)
+                .map(|code| io::Error::from_raw_os_error(code as i32))
+                .unwrap_or_else(|| io::Error::other(error.to_string())));
+        }
+        Ok(reply)
+    }
+
+    pub(crate) async fn read(&mut self, offset: u64, len: usize) -> io::Result<FileReadBlock> {
+        use base64::Engine as _;
+        let reply = self
+            .exchange(serde_json::json!({"offset":offset,"len":len}))
+            .await?;
+        let bytes = reply
+            .get("data")
+            .and_then(serde_json::Value::as_str)
+            .ok_or_else(|| io::Error::other("missing sandboxed read data"))?;
+        let bytes = base64::engine::general_purpose::STANDARD
+            .decode(bytes)
+            .map_err(io::Error::other)?;
+        if bytes.len() > len {
+            return Err(io::Error::other("oversized sandboxed read block"));
+        }
+        let eof = reply
+            .get("eof")
+            .and_then(serde_json::Value::as_bool)
+            .ok_or_else(|| io::Error::other("missing sandboxed read EOF"))?;
+        Ok(FileReadBlock { bytes, eof })
+    }
+}
+
+fn worker() -> io::Result<()> {
+    use base64::Engine as _;
+    let mut input = io::stdin().lock();
+    let mut output = io::stdout().lock();
+    let mut header = String::new();
+    input.read_line(&mut header)?;
+    if header.len() > 64 * 1024 {
+        return Err(io::Error::other("oversized sandboxed read path"));
+    }
+    let init: serde_json::Value = serde_json::from_str(&header)?;
+    let uri: PathUri = serde_json::from_value(
+        init.get("path")
+            .cloned()
+            .ok_or_else(|| io::Error::other("missing sandboxed read path"))?,
+    )?;
+    let path = uri.to_abs_path()?;
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK)
+        .open(path.as_path())?;
+    if !file.metadata()?.is_file() {
+        return Err(io::Error::other(
+            "sandboxed streaming reads require a regular file",
+        ));
+    }
+    writeln!(output, "{{\"opened\":true}}")?;
+    output.flush()?;
+    for line in input.lines() {
+        let line = line?;
+        if line.len() > 4096 {
+            return Err(io::Error::other("oversized sandboxed read request"));
+        }
+        let request: serde_json::Value = serde_json::from_str(&line)?;
+        let offset = request
+            .get("offset")
+            .and_then(serde_json::Value::as_u64)
+            .ok_or_else(|| io::Error::other("missing read offset"))?;
+        let len = request
+            .get("len")
+            .and_then(serde_json::Value::as_u64)
+            .ok_or_else(|| io::Error::other("missing read length"))?;
+        if len == 0 || len > crate::FILE_READ_CHUNK_SIZE as u64 {
+            return Err(io::Error::other("invalid read length"));
+        }
+        let mut bytes = vec![0; len as usize];
+        let mut read = 0;
+        while read < bytes.len() {
+            let position = offset
+                .checked_add(read as u64)
+                .ok_or_else(|| io::Error::other("read offset overflow"))?;
+            match file.read_at(&mut bytes[read..], position) {
+                Ok(0) => break,
+                Ok(count) => read += count,
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(error) => return Err(error),
+            }
+        }
+        bytes.truncate(read);
+        let reply = serde_json::json!({"data":base64::engine::general_purpose::STANDARD.encode(&bytes),"eof":read < len as usize});
+        serde_json::to_writer(&mut output, &reply)?;
+        writeln!(output)?;
+        output.flush()?;
+    }
+    Ok(())
+}
+
+/// Entered only after the parent has installed the composed native sandbox.
+pub fn worker_main() -> ! {
+    match worker() {
+        Ok(()) => std::process::exit(0),
+        Err(error) => {
+            println!(
+                "{}",
+                serde_json::json!({"error":error.to_string(),"os_error":error.raw_os_error()})
+            );
+            std::process::exit(1);
+        }
+    }
+}
