+//! Controller-only native execution service; never loads user configuration,
+//! login credentials or model state. Every worker retains native Seatbelt.
+use std::error::Error;
+
+fn main() -> Result<(), Box<dyn Error + Send + Sync>> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.as_slice() == ["--version"] {
+        println!(
+            "{}",
+            serde_json::json!({"contract":"astudio-composed-native-executor/v2",
+            "package_version":env!("CARGO_PKG_VERSION"),
+            "source_commit":option_env!("ASTUDIO_EVAL_SOURCE_COMMIT"),
+            "patch_sha256":option_env!("ASTUDIO_EVAL_PATCH_SHA256")})
+        );
+        return Ok(());
+    }
+    #[cfg(target_os = "macos")]
+    if args
+        .first()
+        .is_some_and(|arg| arg == "--astudio-controller-exec-arg0")
+    {
+        use std::os::unix::process::CommandExt;
+        if args.len() < 3 {
+            return Err("missing inner argv0/executable".into());
+        }
+        return Err(std::process::Command::new(&args[2])
+            .arg0(&args[1])
+            .args(&args[3..])
+            .exec()
+            .into());
+    }
+    if args
+        .first()
+        .is_some_and(|arg| arg == codex_exec_server::CODEX_FS_HELPER_ARG1)
+    {
+        codex_exec_server::run_fs_helper_main();
+    }
+    #[cfg(target_os = "macos")]
+    if args
+        .first()
+        .is_some_and(|arg| arg == codex_exec_server::CONTROLLER_READ_ARG1)
+    {
+        codex_exec_server::run_controller_read_main();
+    }
+    #[cfg(target_os = "macos")]
+    {
+        if args.len() != 4 || args[0] != "--deny-profile" || args[2] != "--audit-dir" {
+            return Err(
+                "required: --deny-profile <frozen SBPL> --audit-dir <private directory>".into(),
+            );
+        }
+        let profile = std::fs::read_to_string(&args[1])?;
+        codex_sandboxing::controller_seatbelt::install(&profile, std::path::Path::new(&args[3]))?;
+        let paths = codex_exec_server::ExecServerRuntimePaths::new(
+            std::env::current_exe()?,
+            /*codex_linux_sandbox_exe*/ None,
+        )?;
+        tokio::runtime::Builder::new_multi_thread()
+            .enable_all()
+            .build()?
+            .block_on(codex_exec_server::run_main("stdio://", paths))
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        Err("the memory execution controller requires macOS Seatbelt".into())
+    }
+}
