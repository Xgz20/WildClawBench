+use super::*;
+use codex_exec_server::ExecBackendFuture;
+use codex_exec_server::ExecProcess;
+use codex_exec_server::ExecProcessEventReceiver;
+use codex_exec_server::ExecProcessFuture;
+use codex_exec_server::ProcessId;
+use codex_exec_server::ProcessOutputChunk;
+use codex_exec_server::ProcessSignal;
+use codex_exec_server::ReadResponse;
+use codex_exec_server::StartedExecProcess;
+use codex_exec_server::WriteResponse;
+use pretty_assertions::assert_eq;
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tokio::sync::watch;
+
+#[derive(Default)]
+struct FakeBackend {
+    starts: Mutex<Vec<codex_exec_server::ExecParams>>,
+    process: Arc<FakeProcess>,
+}
+
+struct FakeProcess {
+    id: ProcessId,
+    pages: Mutex<VecDeque<std::result::Result<ReadResponse, ExecServerError>>>,
+    cursors: Mutex<Vec<Option<u64>>>,
+    terminated: AtomicUsize,
+}
+
+impl Default for FakeProcess {
+    fn default() -> Self {
+        Self {
+            id: "fake-remote-process".into(),
+            pages: Mutex::default(),
+            cursors: Mutex::default(),
+            terminated: AtomicUsize::new(0),
+        }
+    }
+}
+
+impl ExecBackend for FakeBackend {
+    fn start(&self, params: codex_exec_server::ExecParams) -> ExecBackendFuture<'_> {
+        self.starts.lock().unwrap().push(params);
+        Box::pin(async {
+            Ok(StartedExecProcess {
+                process: self.process.clone(),
+            })
+        })
+    }
+}
+
+impl ExecProcess for FakeProcess {
+    fn process_id(&self) -> &ProcessId {
+        &self.id
+    }
+    fn subscribe_wake(&self) -> watch::Receiver<u64> {
+        watch::channel(0).1
+    }
+    fn subscribe_events(&self) -> ExecProcessEventReceiver {
+        ExecProcessEventReceiver::empty()
+    }
+    fn read(
+        &self,
+        after_seq: Option<u64>,
+        _: Option<usize>,
+        _: Option<u64>,
+    ) -> ExecProcessFuture<'_, ReadResponse> {
+        self.cursors.lock().unwrap().push(after_seq);
+        let pending_page = self.pages.lock().unwrap().pop_front();
+        Box::pin(async move {
+            if let Some(page) = pending_page {
+                return page;
+            }
+            if self.terminated.load(Ordering::SeqCst) > 0 {
+                return Ok(page(Vec::new(), 1));
+            }
+            std::future::pending().await
+        })
+    }
+    fn write(&self, _: Vec<u8>) -> ExecProcessFuture<'_, WriteResponse> {
+        panic!("classic shell has closed stdin")
+    }
+    fn signal(&self, _: ProcessSignal) -> ExecProcessFuture<'_, ()> {
+        panic!("unexpected signal")
+    }
+    fn terminate(&self) -> ExecProcessFuture<'_, ()> {
+        self.terminated.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async { Ok(()) })
+    }
+}
+
+fn request() -> ExecRequest {
+    let cwd = AbsolutePathBuf::try_from(std::env::current_dir().unwrap()).unwrap();
+    let permissions = PermissionProfile::workspace_write();
+    let mut request = ExecRequest::new(
+        vec!["remote-only-shell".into(), "do-work".into()],
+        cwd.clone(),
+        HashMap::from([("SYNTHETIC_ENV".into(), "fixture".into())]),
+        /*network*/ None,
+        /*network_environment_id*/ None,
+        ExecExpiration::DefaultTimeout,
+        ExecCapturePolicy::ShellTool,
+        SandboxType::MacosSeatbelt,
+        vec![cwd.clone()],
+        codex_protocol::config_types::WindowsSandboxLevel::Disabled,
+        /*windows_sandbox_private_desktop*/ false,
+        permissions.clone(),
+        Some("native-argv0".into()),
+    );
+    let mut sandbox =
+        codex_exec_server::FileSystemSandboxContext::from_permission_profile(permissions);
+    sandbox.cwd = Some(cwd.into());
+    request.exec_server_sandbox = Some(sandbox);
+    request
+}
+
+fn page(chunks: Vec<ProcessOutputChunk>, code: i32) -> ReadResponse {
+    ReadResponse {
+        next_seq: chunks.last().map_or(1, |chunk| chunk.seq + 1),
+        chunks,
+        exited: true,
+        exit_code: Some(code),
+        closed: true,
+        failure: None,
+        sandbox_denied: false,
+    }
+}
+
+fn chunk(
+    seq: u64,
+    stream: codex_exec_server::ExecOutputStream,
+    bytes: &[u8],
+) -> ProcessOutputChunk {
+    ProcessOutputChunk {
+        seq,
+        stream,
+        chunk: bytes.to_vec().into(),
+    }
+}
+
+#[tokio::test]
+async fn exec_remote_forwards_native_permissions_and_drains_closed_pages() {
+    let backend = FakeBackend::default();
+    backend.process.pages.lock().unwrap().extend([
+        Ok(page(
+            vec![chunk(
+                1,
+                codex_exec_server::ExecOutputStream::Stdout,
+                b"hello",
+            )],
+            7,
+        )),
+        Ok(page(
+            vec![chunk(
+                2,
+                codex_exec_server::ExecOutputStream::Stderr,
+                b"problem",
+            )],
+            7,
+        )),
+        Ok(page(Vec::new(), 7)),
+    ]);
+    let request = request();
+    let expected = (
+        request.command.clone(),
+        request.cwd.clone(),
+        request.env.clone(),
+        request.arg0.clone(),
+        request.exec_server_sandbox.clone(),
+    );
+    let (tx_event, rx_event) = async_channel::unbounded();
+    let output = execute_remote(
+        request,
+        &backend,
+        Some(StdoutStream {
+            sub_id: "turn".into(),
+            call_id: "call".into(),
+            tx_event,
+        }),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        (
+            output.exit_code,
+            output.stdout.text,
+            output.stderr.text,
+            output.aggregated_output.text,
+            output.timed_out
+        ),
+        (
+            7,
+            "hello".into(),
+            "problem".into(),
+            "helloproblem".into(),
+            false
+        )
+    );
+    let mut starts = backend.starts.lock().unwrap();
+    assert_eq!(starts.len(), 1);
+    let actual = starts.pop().unwrap();
+    assert_eq!(
+        (
+            actual.argv,
+            actual.cwd,
+            actual.env,
+            actual.arg0,
+            actual.sandbox
+        ),
+        expected
+    );
+    assert_eq!(
+        actual.env_policy.unwrap().inherit,
+        ShellEnvironmentPolicyInherit::None
+    );
+    assert_eq!(
+        *backend.process.cursors.lock().unwrap(),
+        vec![None, Some(1), Some(2)]
+    );
+    assert_eq!(rx_event.len(), 2);
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn exec_remote_timeout_terminates_the_executor_process() {
+    let backend = FakeBackend::default();
+    let mut request = request();
+    request.expiration = ExecExpiration::Timeout(Duration::from_millis(1));
+    let result = execute_remote(request, &backend, None).await;
+    let Err(CodexErr::Sandbox(SandboxErr::Timeout { output })) = result else {
+        panic!("missing shell timeout")
+    };
+    assert_eq!((output.exit_code, output.timed_out), (124, true));
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn exec_remote_cancellation_terminates_without_reporting_timeout() {
+    let backend = FakeBackend::default();
+    let mut request = request();
+    let cancellation = CancellationToken::new();
+    cancellation.cancel();
+    request.expiration = ExecExpiration::Cancellation(cancellation);
+    let output = execute_remote(request, &backend, None).await.unwrap();
+    assert_eq!((output.exit_code, output.timed_out), (1, false));
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn exec_remote_preserves_executor_denial_classification() {
+    let backend = FakeBackend::default();
+    let mut denied = page(Vec::new(), 1);
+    denied.sandbox_denied = true;
+    backend.process.pages.lock().unwrap().push_back(Ok(denied));
+    assert!(matches!(
+        execute_remote(request(), &backend, None).await,
+        Err(CodexErr::Sandbox(SandboxErr::Denied { .. }))
+    ));
+}
+
+#[tokio::test]
+async fn exec_remote_disconnect_fails_without_local_fallback() {
+    let backend = FakeBackend::default();
+    backend
+        .process
+        .pages
+        .lock()
+        .unwrap()
+        .push_back(Err(ExecServerError::Closed));
+    assert!(matches!(
+        execute_remote(request(), &backend, None).await,
+        Err(CodexErr::Io(_))
+    ));
+    assert_eq!(backend.starts.lock().unwrap().len(), 1);
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn exec_remote_caps_retained_shell_output_and_still_drains() {
+    let backend = FakeBackend::default();
+    backend.process.pages.lock().unwrap().extend([
+        Ok(page(
+            vec![chunk(
+                1,
+                codex_exec_server::ExecOutputStream::Stdout,
+                &vec![b'x'; EXEC_OUTPUT_MAX_BYTES + 99],
+            )],
+            0,
+        )),
+        Ok(page(
+            vec![chunk(
+                2,
+                codex_exec_server::ExecOutputStream::Stderr,
+                b"last",
+            )],
+            0,
+        )),
+        Ok(page(Vec::new(), 0)),
+    ]);
+    let output = execute_remote(request(), &backend, None).await.unwrap();
+    assert_eq!(output.stdout.text.len(), EXEC_OUTPUT_MAX_BYTES);
+    assert_eq!(output.stderr.text, "last");
+    assert_eq!(output.aggregated_output.text.len(), EXEC_OUTPUT_MAX_BYTES);
+    assert_eq!(backend.process.cursors.lock().unwrap().len(), 3);
+}
