+++ b/codex-rs/core/src/exec_remote.rs
@@ -0,0 +1,165 @@
+//! The classic shell runtime must use its selected remote executor too.
+//!
+//! Reuse the core shell output/error contract while the executor, rather than
+//! this host, compiles and installs the portable native permission profile.
+use super::*;
+use codex_exec_server::ExecBackend;
+use codex_exec_server::ExecEnvPolicy;
+use codex_exec_server::ExecServerError;
+use codex_protocol::config_types::ShellEnvironmentPolicyInherit;
+use uuid::Uuid;
+
+pub(crate) async fn execute_remote(
+    request: ExecRequest,
+    backend: &dyn ExecBackend,
+    stdout_stream: Option<StdoutStream>,
+) -> Result<ExecToolCallOutput> {
+    let started_at = Instant::now();
+    let started = backend
+        .start(codex_exec_server::ExecParams {
+            process_id: format!("shell-{}", Uuid::new_v4()).into(),
+            argv: request.command,
+            cwd: request.cwd,
+            // `request.env` already contains the shell policy's complete
+            // projection. Do not inherit the execution service's environment.
+            env_policy: Some(ExecEnvPolicy {
+                inherit: ShellEnvironmentPolicyInherit::None,
+                ignore_default_excludes: false,
+                exclude: Vec::new(),
+                r#set: HashMap::new(),
+                include_only: Vec::new(),
+            }),
+            env: request.env,
+            tty: false,
+            pipe_stdin: false,
+            arg0: request.arg0,
+            sandbox: request.exec_server_sandbox,
+            enforce_managed_network: request.exec_server_enforce_managed_network,
+            managed_network: request.exec_server_managed_network,
+        })
+        .await
+        .map_err(remote_error)?;
+    let process = started.process;
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    let mut after_seq = None;
+    let mut emitted = 0;
+    let mut sandbox_denied = false;
+    let mut expiration = Box::pin(request.expiration.wait_with_outcome());
+    let mut expired = None;
+    let mut drain_deadline = None;
+    let exit_code = loop {
+        let read = process.read(after_seq, Some(READ_CHUNK_SIZE), Some(100));
+        let response = tokio::select! {
+            biased;
+            outcome = &mut expiration, if expired.is_none() && request.capture_policy.uses_expiration() => {
+                process.terminate().await.map_err(remote_error)?;
+                expired = Some(outcome);
+                drain_deadline = Some(tokio::time::Instant::now() + request.capture_policy.io_drain_timeout());
+                continue;
+            }
+            _ = async {
+                if let Some(deadline) = drain_deadline {
+                    tokio::time::sleep_until(deadline).await;
+                } else {
+                    std::future::pending::<()>().await;
+                }
+            } => break 1,
+            response = read => match response {
+                Ok(response) => response,
+                Err(err) => {
+                    let _ = process.terminate().await;
+                    return Err(remote_error(err));
+                }
+            },
+        };
+        if let Some(failure) = response.failure {
+            let _ = process.terminate().await;
+            return Err(remote_error(ExecServerError::Protocol(failure)));
+        }
+        sandbox_denied |= response.sandbox_denied;
+        let page_empty = response.chunks.is_empty();
+        for chunk in response.chunks {
+            after_seq = Some(chunk.seq);
+            let is_stderr = match chunk.stream {
+                codex_exec_server::ExecOutputStream::Stderr => true,
+                codex_exec_server::ExecOutputStream::Stdout
+                | codex_exec_server::ExecOutputStream::Pty => false,
+            };
+            let output = if is_stderr { &mut stderr } else { &mut stdout };
+            if let Some(limit) = request.capture_policy.retained_bytes_cap() {
+                append_capped(output, &chunk.chunk.0, limit);
+            } else {
+                output.extend_from_slice(&chunk.chunk.0);
+            }
+            if let Some(stream) = &stdout_stream
+                && emitted < MAX_EXEC_OUTPUT_DELTAS_PER_CALL
+            {
+                let _ = stream
+                    .tx_event
+                    .send(Event {
+                        id: stream.sub_id.clone(),
+                        msg: EventMsg::ExecCommandOutputDelta(ExecCommandOutputDeltaEvent {
+                            call_id: stream.call_id.clone(),
+                            stream: if is_stderr {
+                                ExecOutputStream::Stderr
+                            } else {
+                                ExecOutputStream::Stdout
+                            },
+                            chunk: chunk.chunk.0,
+                        }),
+                    })
+                    .await;
+                emitted += 1;
+            }
+        }
+        // `closed` can be true before all retained chunks fit in this page;
+        // `next_seq` is page-relative, not the process's final sequence.
+        if response.closed && page_empty {
+            break response.exit_code.ok_or_else(|| {
+                remote_error(ExecServerError::Protocol(
+                    "remote shell closed without an exit status".into(),
+                ))
+            })?;
+        }
+    };
+    let stdout = StreamOutput {
+        text: stdout,
+        truncated_after_lines: None,
+    };
+    let stderr = StreamOutput {
+        text: stderr,
+        truncated_after_lines: None,
+    };
+    let aggregated_output = aggregate_output(
+        &stdout,
+        &stderr,
+        request.capture_policy.retained_bytes_cap(),
+    );
+    let output = finalize_exec_result(
+        Ok(RawExecToolCallOutput {
+            exit_status: synthetic_exit_status_for_code(exit_code),
+            stdout,
+            stderr,
+            aggregated_output,
+            timed_out: expired == Some(ExecExpirationOutcome::TimedOut),
+        }),
+        request.sandbox,
+        started_at.elapsed(),
+    )?;
+    if sandbox_denied {
+        return Err(CodexErr::Sandbox(SandboxErr::Denied {
+            output: Box::new(output),
+            network_policy_decision: None,
+        }));
+    }
+    Ok(output)
+}
+
+fn remote_error(error: ExecServerError) -> CodexErr {
+    CodexErr::Io(io::Error::other(format!("remote shell: {error}")))
+}
+
+#[cfg(test)]
+#[path = "exec_remote_tests.rs"]
+mod tests;
