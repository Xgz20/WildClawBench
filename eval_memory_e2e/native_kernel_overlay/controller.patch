+use super::compose;
+use super::deny_fragment;
+use super::install;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn literal_denies_preserve_native_bytes_and_parameters() {
+    let dir = tempfile::tempdir().expect("audit directory");
+    let profile = "(version 1)\n(allow default)\n(deny file-read* file-write* (subpath \"/synthetic/old\"))\n(deny appleevent-send)\n";
+    install(profile, dir.path()).expect("install immutable controller boundary");
+    let native = "(version 1)\n(deny default)\n(allow file-read* (subpath (param \"ROOT\")))\n";
+    let parameters = vec![("ROOT".to_owned(), "/synthetic/current".into())];
+    let result = compose(native.into(), &parameters).expect("compose");
+    assert_eq!(
+        result,
+        format!(
+            "{native}\n; immutable controller deny boundary\n{}",
+            deny_fragment(profile).expect("deny fragment")
+        )
+    );
+    assert!(
+        install(profile, dir.path()).is_err(),
+        "an RPC cannot replace the boundary"
+    );
+    let recorded: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(
+            dir.path()
+                .join(format!("policy-{}-0.json", std::process::id())),
+        )
+        .expect("audit policy"),
+    )
+    .expect("audit JSON");
+    assert_eq!(
+        recorded,
+        serde_json::json!({"native_profile":native,"combined_profile":result,"parameters":parameters,"controller_grants_appended":false})
+    );
+}
+
+#[test]
+fn controller_policy_cannot_inject_grants_code_or_relative_paths() {
+    for body in [
+        "(allow file-read*)",
+        "(include \"/file\")",
+        "(define deny allow)",
+        "(deny file-read* (begin (allow default)))",
+        "(deny file-read* (subpath \"relative\"))",
+        "(deny file-read* (subpath \"/ok\") file-write*)",
+        "(deny)",
+        "(deny file-read* (subpath \"/ok\")",
+        "",
+    ] {
+        let profile = format!("(version 1)\n(allow default)\n{body}");
+        assert!(deny_fragment(&profile).is_err(), "{body}");
+    }
+}
