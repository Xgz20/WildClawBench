+//! An immutable controller deny boundary for a dedicated macOS execution service.
+//! Native grants are generated first and retained byte-for-byte. This boundary
+//! can only append literal explicit denies, never replace or enlarge grants.
+
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+const HEADER: &str = "(version 1)\n(allow default)\n";
+static BOUNDARY: OnceLock<ControllerBoundary> = OnceLock::new();
+
+struct ControllerBoundary {
+    denies: String,
+    audit_dir: PathBuf,
+    sequence: AtomicU64,
+}
+
+#[derive(Debug, PartialEq)]
+enum Form {
+    Atom(String),
+    Text(String),
+    List(Vec<Form>),
+}
+
+fn parse(source: &str, cursor: &mut usize) -> Result<Form, String> {
+    let bytes = source.as_bytes();
+    while bytes.get(*cursor).is_some_and(u8::is_ascii_whitespace) {
+        *cursor += 1;
+    }
+    match bytes.get(*cursor) {
+        Some(b'(') => {
+            *cursor += 1;
+            let mut items = Vec::new();
+            loop {
+                while bytes.get(*cursor).is_some_and(u8::is_ascii_whitespace) {
+                    *cursor += 1;
+                }
+                match bytes.get(*cursor) {
+                    Some(b')') => {
+                        *cursor += 1;
+                        return Ok(Form::List(items));
+                    }
+                    None => return Err("unclosed controller deny form".into()),
+                    _ => items.push(parse(source, cursor)?),
+                }
+            }
+        }
+        Some(b'"') => {
+            let start = *cursor;
+            *cursor += 1;
+            loop {
+                match bytes.get(*cursor) {
+                    Some(b'\\') => *cursor += 2,
+                    Some(b'"') => {
+                        *cursor += 1;
+                        let text = serde_json::from_str(&source[start..*cursor])
+                            .map_err(|error| format!("invalid controller literal: {error}"))?;
+                        return Ok(Form::Text(text));
+                    }
+                    Some(_) => *cursor += 1,
+                    None => return Err("unclosed controller literal".into()),
+                }
+            }
+        }
+        Some(b')') | None => Err("unexpected controller deny token".into()),
+        Some(_) => {
+            let start = *cursor;
+            while bytes
+                .get(*cursor)
+                .is_some_and(|byte| !byte.is_ascii_whitespace() && !matches!(byte, b'(' | b')'))
+            {
+                *cursor += 1;
+            }
+            Ok(Form::Atom(source[start..*cursor].into()))
+        }
+    }
+}
+
+fn filter(form: &Form) -> Result<(), String> {
+    let Form::List(items) = form else {
+        return Err("controller filter must be a list".into());
+    };
+    let Some(Form::Atom(name)) = items.first() else {
+        return Err("missing controller filter name".into());
+    };
+    match name.as_str() {
+        "literal" | "subpath" => match items.as_slice() {
+            [_, Form::Text(path)] if path.starts_with('/') && !path.contains('\0') => Ok(()),
+            _ => Err("controller paths must be absolute literals".into()),
+        },
+        "require-all" | "require-any" | "require-not" => {
+            if items.len() < 2 || (name == "require-not" && items.len() != 2) {
+                return Err("invalid controller filter arity".into());
+            }
+            items[1..].iter().try_for_each(filter)
+        }
+        _ => Err("code, includes, macros and grants are forbidden in controller denies".into()),
+    }
+}
+
+fn deny_fragment(profile: &str) -> Result<&str, String> {
+    if profile.len() > 256 * 1024 {
+        return Err("controller profile exceeds 256 KiB".into());
+    }
+    let body = profile
+        .strip_prefix(HEADER)
+        .ok_or("invalid controller profile header")?;
+    let mut cursor = 0;
+    let mut count = 0;
+    while !body[cursor..].trim().is_empty() {
+        let Form::List(items) = parse(body, &mut cursor)? else {
+            return Err("controller policy must contain only explicit denies".into());
+        };
+        if !matches!(items.first(), Some(Form::Atom(name)) if name == "deny") {
+            return Err("controller policy cannot append grants".into());
+        }
+        let mut operations = 0;
+        let mut filters_started = false;
+        for item in &items[1..] {
+            if let Form::Atom(operation) = item {
+                if filters_started
+                    || !matches!(
+                        operation.as_str(),
+                        "file-read*" | "file-write*" | "file-read-data" | "appleevent-send"
+                    )
+                {
+                    return Err("unsupported controller operation".into());
+                }
+                operations += 1;
+            } else {
+                if operations == 0 {
+                    return Err("missing controller deny operation".into());
+                }
+                filters_started = true;
+                filter(item)?;
+            }
+        }
+        if operations == 0 {
+            return Err("missing controller deny operation".into());
+        }
+        count += 1;
+    }
+    if count == 0 {
+        return Err("empty controller boundary".into());
+    }
+    Ok(body)
+}
+
+/// Install once, before starting the dedicated controller's RPC service.
+/// No request or child environment can replace this process-owned boundary.
+pub fn install(profile: &str, audit_dir: &Path) -> Result<(), String> {
+    let denies = deny_fragment(profile)?.to_owned();
+    if !audit_dir.is_absolute()
+        || fs::canonicalize(audit_dir).map_err(|e| e.to_string())? != audit_dir
+    {
+        return Err(
+            "controller audit directory must be an existing canonical absolute path".into(),
+        );
+    }
+    let loaded = audit_dir.join(format!("loaded-denies-{}.sb", std::process::id()));
+    let mut file = fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(loaded)
+        .map_err(|e| e.to_string())?;
+    std::io::Write::write_all(&mut file, profile.as_bytes()).map_err(|e| e.to_string())?;
+    BOUNDARY
+        .set(ControllerBoundary {
+            denies,
+            audit_dir: audit_dir.into(),
+            sequence: AtomicU64::new(0),
+        })
+        .map_err(|_| "controller boundary already installed".into())
+}
+
+/// Whether every execution/file request must use native Seatbelt enforcement.
+pub fn is_active() -> bool {
+    BOUNDARY.get().is_some()
+}
+
+pub(crate) fn compose(native: String, parameters: &[(String, PathBuf)]) -> Result<String, String> {
+    let Some(boundary) = BOUNDARY.get() else {
+        return Ok(native);
+    };
+    let combined = format!(
+        "{native}\n; immutable controller deny boundary\n{}",
+        boundary.denies
+    );
+    let sequence = boundary.sequence.fetch_add(1, Ordering::Relaxed);
+    let record = serde_json::json!({"native_profile": native, "combined_profile": combined,
+        "parameters": parameters, "controller_grants_appended": false});
+    let target = boundary
+        .audit_dir
+        .join(format!("policy-{}-{sequence}.json", std::process::id()));
+    let mut file = fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(target)
+        .map_err(|e| e.to_string())?;
+    serde_json::to_writer(&mut file, &record).map_err(|e| e.to_string())?;
+    Ok(combined)
+}
+
