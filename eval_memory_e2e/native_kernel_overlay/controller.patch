@@ -0,0 +1,31 @@
+//! The dedicated controller never executes a request outside native Seatbelt,
+//! including a missing, disabled or externally-enforced native sandbox intent.
+use std::sync::LazyLock;
+
+use crate::FileSystemSandboxContext;
+use codex_protocol::models::PermissionProfile;
+
+static UNRESTRICTED_NATIVE_INTENT: LazyLock<FileSystemSandboxContext> = LazyLock::new(|| {
+    FileSystemSandboxContext::from_permission_profile(PermissionProfile::Disabled)
+});
+
+pub(crate) fn active() -> bool {
+    #[cfg(target_os = "macos")]
+    {
+        codex_sandboxing::controller_seatbelt::is_active()
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        false
+    }
+}
+
+pub(crate) fn context(
+    sandbox: Option<&FileSystemSandboxContext>,
+) -> Option<&FileSystemSandboxContext> {
+    if active() {
+        sandbox.or(Some(&UNRESTRICTED_NATIVE_INTENT))
+    } else {
+        sandbox
+    }
+}
