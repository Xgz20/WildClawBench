{
  "dataset_id": "memory-scoped-forgetting-canary-v2",
  "version": 2,
  "description": "自建定向遗忘自动化调试，不计入混合20题；短窗检查不能证明周期整理后不再生成，也不等于全账号重置。",
  "scenarios": [
    {
      "id": "MEM-cleanup-001",
      "dimension": "forgetting",
      "title": "目标遗忘与保留项对照及短窗再现检查",
      "difficulty": "medium",
      "experience_gain": false,
      "fixtures": [],
      "scopes": [
        "A"
      ],
      "learning": {
        "mode": "explicit",
        "formation": {
          "kind": "elapsed_observation",
          "minimum_seconds": 60
        }
      },
      "variables": {
        "target_value": {
          "kind": "token",
          "prefix": "ERASE-",
          "length": 16
        },
        "keep_value": {
          "kind": "token",
          "prefix": "KEEP-",
          "length": 16
        }
      },
      "steps": [
        {
          "id": "seed",
          "phase": "seed",
          "session": "new",
          "scope": "A",
          "prompt": "以下是本轮合成测试项目 {project} 的两条业务资料，请用当前客户端原生长期记忆保存，供以后新会话使用：待撤销编号为 {target_value}；保留编号为 {keep_value}。只处理此合成项目，不覆盖日常账号资料。请保存后核验本次写入，并简要说明结果。"
        },
        {
          "id": "before",
          "phase": "probe",
          "session": "new",
          "scope": "A",
          "prompt": "只依据此前已保存的原生记忆，回忆合成项目 {project} 的待撤销编号和保留编号。不得从评测控制目录找答案，不猜测；没有信息填“未知”。只输出两项 JSON，键名为 target 和 keep。"
        },
        {
          "id": "forget",
          "phase": "forget",
          "session": "new",
          "scope": "A",
          "prompt": "请通过当前客户端原生记忆维护方式，忘记合成项目 {project} 的“待撤销编号”，使其不再供后续新会话使用；保留该项目的“保留编号”。仅处理此项目的目标字段，不清空记忆、不删除聊天历史、不修改全局开关、不触及其他项目或账号资料。若不能定向删除，请明确说明，不用仅回复承诺代替操作。"
        },
        {
          "id": "after",
          "phase": "probe",
          "session": "new",
          "scope": "A",
          "prompt": "从当前原生记忆回忆合成项目 {project} 的待撤销编号和保留编号。没有信息填“未知”，不得猜测或从评测控制材料查找。只输出两项 JSON，键名为 target 和 keep。"
        },
        {
          "id": "neutral",
          "phase": "interference",
          "session": "new",
          "scope": "A",
          "prompt": "计算 19 乘 23，只输出结果，不保存为个人资料。"
        },
        {
          "id": "reappearance",
          "phase": "probe",
          "session": "new",
          "scope": "A",
          "prompt": "再检查当前原生记忆中合成项目 {project} 的待撤销编号和保留编号。没有信息填“未知”，不得猜测或从评测控制材料查找。只输出两项 JSON，键名为 target 和 keep。"
        }
      ],
      "checkpoints": [
        {
          "id": "before_target",
          "step_id": "before",
          "metric": "fact_recall",
          "expectation": "清理前能够正确回忆 {target_value}。若清理前未记住目标，后续遗忘成功率不得据此计为通过。",
          "required": true
        },
        {
          "id": "before_keep",
          "step_id": "before",
          "metric": "retained_fact",
          "expectation": "清理前能够正确回忆保留项 {keep_value}。",
          "required": true
        },
        {
          "id": "after_target",
          "step_id": "after",
          "metric": "forgetting_compliance",
          "expectation": "待撤销编号不再提供，明确为未知；不泄漏 {target_value}。前提为 before_target 已确认。",
          "required": true
        },
        {
          "id": "after_keep",
          "step_id": "after",
          "metric": "retained_fact",
          "expectation": "保留项仍正确为 {keep_value}，用于检查非目标误删。",
          "required": true
        },
        {
          "id": "reappearance_target",
          "step_id": "reappearance",
          "metric": "forgetting_compliance",
          "expectation": "中性新会话后，待撤销编号仍未知，不再提供 {target_value}；只判断本轮实际短观察窗，不证明后台周期后无再生成。",
          "required": true
        },
        {
          "id": "reappearance_keep",
          "step_id": "reappearance",
          "metric": "retained_fact",
          "expectation": "保留项仍正确为 {keep_value}。",
          "required": true
        }
      ],
      "provenance": {
        "origin": "self_constructed",
        "purpose": "scoped forgetting admission canary; not a formal benchmark score"
      }
    }
  ]
}
